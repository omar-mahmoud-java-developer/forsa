# Copy to .env (job-radar init does it). .env is git-ignored. Placeholders only.

# Only needed when notify.mode = "email" and safety.send_emails = true.
# Use an app password of a dedicated mailbox, never your main password.
JOB_RADAR_SMTP_USER=your-address@example.com
JOB_RADAR_SMTP_PASSWORD=app-password-here

# Only needed when llm.provider = "anthropic".
ANTHROPIC_API_KEY=

# Optional: where the project lives (defaults to the current directory).
# JOB_RADAR_HOME=
