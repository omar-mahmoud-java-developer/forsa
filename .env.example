# Copy to .env (forsa init does it). .env is git-ignored. Placeholders only.

# Only needed when notify.mode = "email" and safety.send_emails = true.
# Use an app password of a dedicated mailbox, never your main password.
FORSA_SMTP_USER=
FORSA_SMTP_PASSWORD=

# Optional, only when mailbox.enabled = true (read-only). Defaults to the SMTP values above.
FORSA_IMAP_USER=
FORSA_IMAP_PASSWORD=

# Only needed when llm.provider = "anthropic".
ANTHROPIC_API_KEY=

# Optional: where the project lives (defaults to the current directory).
# FORSA_HOME=
